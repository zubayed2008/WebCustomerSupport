# Copy this file to .env and replace every value before starting the stack.
# The .env file is ignored by Git and must never be committed.

POSTGRES_DB=supportdesk
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used only to create the initial administrator when no administrator exists.
SUPPORTDESK_ADMIN_EMAIL=admin@example.com
SUPPORTDESK_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional. When set, demo manager/agent/customer accounts are seeded for the
# client demonstration. Leave empty to seed only the administrator.
SUPPORTDESK_DEMO_PASSWORD=replace-with-a-long-random-password

# Fake is the safe default. Set to OpenAi and provide Ai__ApiKey for a live provider.
SUPPORTDESK_AI_PROVIDER=Fake
SUPPORTDESK_AI_API_KEY=
SUPPORTDESK_AI_MODEL=
SUPPORTDESK_AI_BASE_URL=

# Public origin used for links in email notifications.
SUPPORTDESK_PUBLIC_URL=http://localhost:8080

# Set to true only for the containerized demonstration environment.
SUPPORTDESK_AUTO_MIGRATE=true
